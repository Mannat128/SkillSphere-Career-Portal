
# ==========================================
# Environment Variables & Secrets
# ==========================================
.env
.env.*
**/.env
**/.env.*

# Allow safe environment templates
!.env.example
!**/.env.example

# ==========================================
# Python Cache & Compiled Files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ==========================================
# Python Build & Distribution
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ==========================================
# Virtual Environments
# ==========================================
venv/
env/
ENV/
.venv/

# ==========================================
# Node & Frontend
# ==========================================
node_modules/
**/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ==========================================
# Database Files & Backups
# ==========================================
*.db
*.sqlite
*.sqlite3
*.sql
*.dump
*.bak

# ==========================================
# Uploads & Private User Documents
# ==========================================
backend/uploads/*
!backend/uploads/.gitkeep

uploads/

# ==========================================
# IDE & Editor Settings
# ==========================================
.idea/
.vscode/
*.swp
*.swo

# ==========================================
# Testing & Coverage
# ==========================================
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

# ==========================================
# Logs & Temporary Files
# ==========================================
*.log
*.tmp
*.temp
.DS_Store
Thumbs.db
