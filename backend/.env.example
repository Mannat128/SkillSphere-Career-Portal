
# ==========================================
# SkillSphere - Career & Job Portal
# Environment Configuration Template
# ==========================================

# Application Configuration
APP_NAME="SkillSphere – Career & Job Portal"
# Local template. In Render, set APP_ENV=production and use the remote TiDB Cloud connection values.
APP_ENV=development
API_V1_PREFIX=/api/v1

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000","https://skill-sphere-career-portal.vercel.app"]

# ==========================================
# Database Configuration (MySQL)
# ==========================================
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_NAME=skillsphere_portal
DATABASE_USER=YOUR_MYSQL_USERNAME
DATABASE_PASSWORD=YOUR_MYSQL_PASSWORD

# ==========================================
# Security & JWT Configuration
# ==========================================
SECRET_KEY=YOUR_SECRET_KEY_HERE
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ==========================================
# Initial Platform Administrator
# ==========================================
ADMIN_NAME=YOUR_ADMIN_NAME
ADMIN_EMAIL=YOUR_ADMIN_EMAIL
ADMIN_PASSWORD=YOUR_ADMIN_PASSWORD

# ==========================================
# AI Configuration (Optional)
# ==========================================
AI_PROVIDER=google_gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# AI_API_KEY remains supported as a legacy server-side Gemini key alias.

# ==========================================
# File Upload Settings
# ==========================================
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=10

# ==========================================
# OCR & Tesseract
# ==========================================
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ==========================================
# Email SMTP Configuration
# ==========================================
EMAIL_MODE=development
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=no-reply@skillsphere.local
EMAILS_FROM_NAME="SkillSphere Notifications"

# ==========================================
# Cloudinary Configuration (assessment recording storage)
# ==========================================
# Use local for offline development. Set to cloudinary when remote private video storage is configured.
STORAGE_BACKEND=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
